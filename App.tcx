"use client";
import React, { useEffect, useState, useRef } from 'react';
import * as THREE from 'three';
import { gsap } from 'gsap';
import { Mic, Home, Tv, MessageSquare, User, X, Coins, Play, Volume2 } from 'lucide-react';

export default function NikkiFlixEmpire() {
  const [room, setRoom] = useState('INTRO');
  const [balance, setBalance] = useState(100000000);
  const [micActive, setMicActive] = useState(false);
  const canvasRef = useRef<HTMLCanvasElement>(null);

  // NATURAL FEMALE VOICE ENGINE
  const speak = (text: string, person: 'Nicole' | 'Promise') => {
    if (typeof window === "undefined") return;
    const msg = new SpeechSynthesisUtterance(text);
    const voices = window.speechSynthesis.getVoices();
    
    // Attempt to find high-quality female voices (Google, Apple, or Microsoft)
    const femaleVoice = voices.find(v => 
      (v.name.includes('Female') || v.name.includes('Google US English') || v.name.includes('Zira') || v.name.includes('Samantha')) && v.lang.includes('en')
    );

    if (femaleVoice) msg.voice = femaleVoice;
    msg.pitch = person === 'Nicole' ? 1.1 : 0.95; // Distinct pitches for the two hosts
    msg.rate = 0.9; // Slightly slower for more "human" feel
    window.speechSynthesis.speak(msg);
  };

  // INTRO SEQUENCE
  useEffect(() => {
    if (room === 'INTRO') {
      setTimeout(() => {
        speak("Welcome to the Nikki Flix Empire. I am Nicole.", "Nicole");
        setTimeout(() => {
          speak("And I am Promise. We are your hosts for this elite session.", "Promise");
          setRoom('LOBBY');
        }, 2500);
      }, 1000);
    }
  }, [room]);

  // 3D HD ENGINE
  useEffect(() => {
    if (!canvasRef.current || room === 'LOBBY' || room === 'INTRO') return;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x020202);
    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ canvas: canvasRef.current, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);

    // HD Lighting
    const ambient = new THREE.AmbientLight(0xffffff, 0.4);
    const spot = new THREE.SpotLight(0xffffff, 2);
    spot.position.set(0, 15, 10);
    scene.add(ambient, spot);

    // Reflective Floor
    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(100, 100),
      new THREE.MeshStandardMaterial({ color: 0x080808, roughness: 0.1, metalness: 0.8 })
    );
    floor.rotation.x = -Math.PI/2;
    scene.add(floor);

    if (room === 'POKER') {
      // Mahogany/Leather Table
      const table = new THREE.Group();
      const felt = new THREE.Mesh(new THREE.CylinderGeometry(6, 6, 0.3, 32), new THREE.MeshStandardMaterial({ color: 0x074221 }));
      const rail = new THREE.Mesh(new THREE.TorusGeometry(6, 0.5, 16, 100), new THREE.MeshStandardMaterial({ color: 0x000000 }));
      rail.rotation.x = Math.PI/2;
      const glow = new THREE.Mesh(new THREE.TorusGeometry(4, 0.05, 16, 100), new THREE.MeshStandardMaterial({ color: 0xa855f7, emissive: 0xa855f7, emissiveIntensity: 3 }));
      glow.rotation.x = Math.PI/2; glow.position.y = 0.2;
      table.add(felt, rail, glow);
      scene.add(table);
      camera.position.set(0, 12, 14);
    }

    camera.lookAt(0, 0, 0);
    const animate = () => { requestAnimationFrame(animate); renderer.render(scene, camera); };
    animate();
    return () => renderer.dispose();
  }, [room]);

  return (
    <div className="bg-[#050505] text-white min-h-screen font-sans overflow-hidden">
      
      {/* 2026 EXECUTIVE HUD */}
      <div className="fixed top-0 left-0 right-0 h-24 bg-black/80 backdrop-blur-3xl border-b border-white/5 z-[100] flex justify-between items-center px-10">
        <div className="flex items-center gap-4">
          <div className="w-12 h-12 bg-gradient-to-br from-yellow-400 to-yellow-700 rounded-xl flex items-center justify-center font-black text-black text-xl">N</div>
          <h1 className="text-2xl font-black tracking-tighter text-yellow-500 italic">NIKKIFLIX EMPIRE</h1>
        </div>
        <div className="flex items-center gap-6 bg-yellow-500/10 border border-yellow-500/30 px-8 py-3 rounded-full">
           <Coins className="text-yellow-500" />
           <span className="text-2xl font-black tracking-widest text-yellow-500">${balance.toLocaleString()}</span>
        </div>
      </div>

      {/* LEFT EXECUTIVE SIDEBAR (Desktop) */}
      <nav className="fixed left-0 top-24 bottom-0 w-64 bg-[#080808] border-r border-white/5 hidden lg:flex flex-col p-6 z-50">
        <div className="space-y-4">
           <button onClick={() => setRoom('LOBBY')} className="w-full flex items-center gap-4 p-4 rounded-xl hover:bg-white/5 text-gray-400 hover:text-yellow-500 transition-all font-bold uppercase text-xs tracking-widest">
              <Home size={20}/> Casino Lobby
           </button>
           <button className="w-full flex items-center gap-4 p-4 rounded-xl hover:bg-white/5 text-gray-400 transition-all font-bold uppercase text-xs tracking-widest">
              <Tv size={20}/> Cinema Slots
           </button>
        </div>
      </nav>

      <main className="lg:pl-64 pt-32 pb-24 h-screen overflow-y-auto px-10">
        
        {room === 'INTRO' && (
          <div className="h-full flex flex-col items-center justify-center text-center">
            <h2 className="text-9xl font-black italic tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-yellow-700 via-yellow-400 to-yellow-800 uppercase animate-pulse">EMPIRE</h2>
            <div className="mt-10 flex gap-10">
               <div className="flex flex-col items-center gap-3">
                  <div className="w-20 h-20 rounded-full border-4 border-yellow-500 bg-[#111]" />
                  <p className="font-black text-yellow-500">NICOLE</p>
               </div>
               <div className="flex flex-col items-center gap-3">
                  <div className="w-20 h-20 rounded-full border-4 border-purple-500 bg-[#111]" />
                  <p className="font-black text-purple-500">PROMISE</p>
               </div>
            </div>
          </div>
        )}

        {room === 'LOBBY' && (
          <div className="animate-in fade-in zoom-in-95 duration-1000">
            <h3 className="text-white/20 uppercase text-[10px] font-black tracking-[0.5em] mb-10">Executive Gaming Floor</h3>
            <div className="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-8">
              <div onClick={() => { setRoom('POKER'); speak("Welcome to the high stakes room. Good luck.", "Nicole"); }} className="group relative aspect-[16/11] bg-gradient-to-br from-green-900 to-black rounded-[2.5rem] border border-white/10 overflow-hidden cursor-pointer hover:scale-105 transition-all duration-500">
                <div className="absolute inset-0 flex items-center justify-center text-7xl opacity-30">🃏</div>
                <div className="absolute bottom-0 inset-x-0 p-8 bg-gradient-to-t from-black to-transparent">
                  <p className="text-lg font-black text-yellow-500 uppercase tracking-tighter">Pro Texas Hold'em</p>
                </div>
              </div>
              <div onClick={() => { setRoom('THEATER'); speak("Welcome to the Cinema. Spin while you watch.", "Promise"); }} className="group relative aspect-[16/11] bg-gradient-to-br from-gray-800 to-black rounded-[2.5rem] border border-white/10 overflow-hidden cursor-pointer hover:scale-105 transition-all duration-500">
                <div className="absolute inset-0 flex items-center justify-center text-7xl opacity-30">🎬</div>
                <div className="absolute bottom-0 inset-x-0 p-8 bg-gradient-to-t from-black to-transparent">
                  <p className="text-lg font-black text-yellow-500 uppercase tracking-tighter">Empire Cinema Slots</p>
                </div>
              </div>
              {/* Add 13 more variations here */}
            </div>
          </div>
        )}

        {(room === 'POKER' || room === 'THEATER') && (
          <div className="fixed inset-0 z-[200] bg-[#020202]">
            <button onClick={() => setRoom('LOBBY')} className="fixed top-10 left-10 z-[300] bg-white/10 backdrop-blur-xl px-8 py-4 rounded-full font-black text-xs border border-white/20 hover:bg-red-600 transition-all">EXIT SUITE</button>
            <canvas ref={canvasRef} className="w-full h-full" />
            
            {room === 'POKER' && (
              <div className="fixed bottom-12 left-10 flex flex-col gap-4 z-[300]">
                 <button className="bg-blue-900 border-2 border-blue-400 px-16 py-6 rounded-3xl font-black uppercase italic shadow-2xl hover:bg-blue-600 transition-all">Check</button>
                 <button className="bg-red-900 border-2 border-red-400 px-16 py-6 rounded-3xl font-black uppercase italic shadow-2xl hover:bg-red-600 transition-all">Fold</button>
                 <button onMouseDown={() => setMicActive(true)} onMouseUp={() => setMicActive(false)} className={`w-24 h-24 rounded-full flex items-center justify-center border-4 ${micActive ? 'bg-green-500 animate-pulse' : 'bg-gray-900 border-yellow-500'}`}><Mic size={32}/></button>
              </div>
            )}

            {room === 'THEATER' && (
               <div className="fixed bottom-10 left-1/2 -translate-x-1/2 w-[90%] max-w-4xl bg-black/80 backdrop-blur-3xl p-10 rounded-[3rem] border border-yellow-500/30 text-center shadow-[0_0_100px_rgba(0,0,0,1)]">
                  <div className="flex justify-center gap-4 mb-8">
                    {[1,2,3,4,5].map(i => <div key={i} className="w-24 h-32 bg-white rounded-xl flex items-center justify-center text-6xl text-black font-bold">🍀</div>)}
                  </div>
                  <button className="w-full py-8 bg-gradient-to-b from-yellow-300 to-yellow-600 text-black font-black text-4xl rounded-[2rem] shadow-[0_20px_50px_rgba(234,179,8,0.3)]">SPIN IN CINEMA</button>
               </div>
            )}
          </div>
        )}
      </main>

      {/* MOBILE EXECUTIVE BOTTOM TABS */}
      <div className="lg:hidden fixed bottom-0 left-0 right-0 h-24 bg-black border-t border-white/10 flex justify-around items-center z-[1000] px-6">
         <div className="flex flex-col items-center text-yellow-500" onClick={() => setRoom('LOBBY')}><Home /><span className="text-[10px] font-black mt-2">LOBBY</span></div>
         <div className="flex flex-col items-center text-gray-500"><MessageSquare /><span className="text-[10px] font-black mt-2">CHAT</span></div>
         <div className="flex flex-col items-center text-gray-500"><User /><span className="text-[10px] font-black mt-2">PROMISE</span></div>
      </div>

    </div>
  );
}
